    async ({ flags, store }, name) => {
      if (isOtpUrl(name)) {
        return await logAndClipCode(new URL(name), flags);
      }
      const url = await store.get(name);
      if (!url) {
        if (fromBase32.is(name)) {
          return await logAndClipCode(urlFromSecret(name), flags);
        }

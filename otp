};

const clipCommands = {
  win32: ["clip", []],
  darwin: ["pbcopy", []],
};

export const clip = (text) => {
  const [cmd, args] =
    clipCommands[process.platform] ??
    (process.env.WAYLAND_DISPLAY
      ? ["wl-copy", []]
      : ["xclip", ["-selection", "clipboard"]]);
  return proc.spawnSync(cmd, args, {
    input: text,
    encoding: "utf-8",
    stdio: ["pipe", "ignore", "ignore"],
  });
};

export const flagsDefault = () =>
  process.stdout.isTTY ? { clipboard: true } : { stdout: true };

const SOURCE =
  "https://raw.githubusercontent.com/Fordi/otp/refs/heads/main/otp";

export async function update({ verbose } = {}) {
  if (verbose) {
    process.stderr.write(`Updating from ${SOURCE}`);
  }
  await writeFile(process.argv[1], await fetch(SOURCE).then((r) => r.body));
  process.exit();
}

export async function parseArgs(args) {
  const commands = [];
  let flags = { ...flagsDefault() };
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (arg[0] === "-" && arg[1] !== "-") {
      for (let j = 1; j < arg.length; j++) {
        const a = arg[j];
        switch (a) {
          case "c":
            flags.clipboard = !flags.clipboard;
            break;
          case "s":
            flags.stdout = !flags.stdout;
            break;
          case "h":
            await usage();
          case "H":
            if (j !== arg.length - 1) {
              throw new Error("H must be last shorthanded single-arg");
            }
            flags.home = args[++i];
            break;
          case "u":
            await update(flags);
          case "v":
            flags.verbose = (flags.verbose ?? 0) + 1;
            break;
          default:
            await usage(1, `Unknown flag: -${a}`);
        }
      }
      continue;
    }
    switch (arg) {
      case "add":
        commands.push(["add", args[++i], args[++i], flags]);
        flags = { ...flagsDefault() };
        break;
      case "code":
        commands.push(["code", args[++i], undefined, flags]);
        flags = { ...flagsDefault() };
        break;
      case "--clip":
        flags.clipboard = !flags.clipboard;
        break;
      case "--stdout":
        flags.stdout = !flags.stdout;
        break;
      case "--help":
        await usage();
      case "--update":
        await update(flags);
      case "--verbose":
        flags.verbose = (flags.verbose ?? 0) + 1;
        break;
      case "--home":
        flags.home = args[++i];
        break;
      default:
        if (arg.startsWith("--")) {
          await usage(1, `Unknown flag: ${arg}`);
        }
        commands.push(["implicit", arg, undefined, flags]);
        flags = { ...flagsDefault() };
        break;
    }
  }
  if (commands.length === 0) {
    commands.push(["list", undefined, undefined, flags]);
  }
  return commands;
}

export const logAndClipCode = async (url, flags) => {
  const code = await otp(url instanceof URL ? url.toString() : url);
  if (flags.stdout) console.log(code);
  if (flags.clipboard) clip(code);
};

export const urlFromSecret = (secret) => {
  const url = new URL("otpauth://totp/anon");
  url.searchParams.set("secret", secret);
  return url;
};
let store;

export async function main(args, env) {
  const commands = await parseArgs(args);

  for (let [command, name, value, flags] of commands) {
    switch (command) {
      case "add":
        store = new SecretManager("org.fordi.otp", env, flags);
        if (isOtpUrl(value)) {
          await store.set(name, new URL(value).toString());
          if (flags.stdout) console.log(`Stored ${name}`);
        } else if (fromBase32.is(value)) {
          await store.set(name, urlFromSecret(value).toString());
        } else {
          await usage(1, `"${value}" is not a valid OTP URL or secret`);
        }
        break;
      case "code":
      case "implicit":
        store = new SecretManager("org.fordi.otp", env, flags);
        if (isOtpUrl(name)) {
          await logAndClipCode(new URL(name), flags);
          break;
        }
        const url = await store.get(name);
        if (!url) {
          if (fromBase32.is(name)) {
            await logAndClipCode(urlFromSecret(name), flags);
            break;
          }
          await usage(1, `No code named ${name}`);
        }
        await logAndClipCode(url, flags);
        break;
      case "list":
        store = new SecretManager("org.fordi.otp", env, flags);
        const keys = await store.list();
        if (!keys.length) {
          process.stderr.write(`No OTPs in the store\n`);
        }
        console.log(keys.join("\n"));
        break;
    }
  }
}

if (process.argv[1] === import.meta.filename) {
  main(process.argv.slice(2), process.env).catch((e) => console.error(e));
}

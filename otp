const byUniqueNameAsc = (a, b) =>
  a.name.toLowerCase() > b.name.toLowerCase() ? 1 : -1;
const elideShort = new Set(["home", "update", "verbose", "encrypted", "import", "export"]);

const argsOf = (fn) => {
  let argList = fn.toString().match(/\((.*?)\)/)[1];
  argList = argList.replace(/=>.*$/, '');
  argList = argList.replace(/^\{.*\}/, 'context');
  argList = argList.split(/, ?/);
  return argList.slice(1);
}


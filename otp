#!/usr/bin/env -S node --no-warnings=ExperimentalWarning
import { spawnSync as _spawnSync } from "node:child_process";
import { existsSync, mkdirSync, realpathSync, renameSync } from "node:fs";
import { chmod, readFile, stat, writeFile } from "node:fs/promises";
import { join, basename } from "node:path";
import { DatabaseSync } from "node:sqlite";
import { gzipSync, gunzipSync } from "node:zlib";

// Exposed for testing.
export const proc = { spawnSync: _spawnSync };

const _promptPassword = (
  promptText,
  { input = process.stdin, output = process.stdout } = {},
) =>
  new Promise((resolve, reject) => {
    output.write(promptText);
    let password = "";
    const isTTY = input.isTTY;
    if (isTTY) input.setRawMode(true);
    input.resume();
    input.setEncoding("utf8");
    const onData = (chunk) => {
      for (const char of chunk) {
        if (char === "\r" || char === "\n") {
          cleanup();
          if (isTTY) output.write("\n");
          resolve(password);
          return;
        }
        if (char === "\u0003") {
          cleanup();
          reject(
            Object.assign(new Error("Prompt cancelled"), { code: "SIGINT" }),
          );
          return;
        }
        if (char === "\u007f" || char === "\b") {
          password = password.slice(0, -1);
          continue;
        }
        password += char;
      }
    };
    const cleanup = () => {
      input.removeListener("data", onData);
      if (isTTY) input.setRawMode(false);
      input.pause();
    };
    input.on("data", onData);
  });

// Exposed for testing.
export const prompt = { password: _promptPassword };

export const hasCommand = (command) =>
  proc.spawnSync("sh", ["-c", `command -v ${command}`]).status === 0;

export const encode = TextEncoder.prototype.encode.bind(new TextEncoder());
export const decode = TextDecoder.prototype.decode.bind(new TextDecoder());
export const getRandomValues = crypto.getRandomValues.bind(crypto);
export const { subtle } = crypto;

export class SecretServiceSecret {
  #attributes;
  #label;
  constructor(attributes, label) {
    this.#label = label;
    this.#attributes = Object.entries(attributes)
      .map(([key, value]) => {
        const t = typeof value;
        if (t === "undefined" || value === null) {
          return undefined;
        }
        if (t !== "string" && t !== "boolean" && t !== "number") {
          throw new Error("Only scalar attributes are supported");
        }
        return [key, String(value)];
      })
      .filter((a) => a !== undefined);
  }
  async read() {
    const cp = proc.spawnSync(
      "secret-tool",
      ["lookup", ...this.#attributes.flat()],
      { encoding: "utf8" },
    );
    if (cp.status !== 0) {
      throw Object.assign(
        new Error(
          `Couldn't read secret with attributes: \n${this.#attributes.map(([key, value]) => `  ${key}="${value}"`)}`,
        ),
        { code: "ENOENT" },
      );
    }
    return new Uint8Array(Buffer.from(cp.stdout, "base64url"));
  }
  async write(secret) {
    const input = Buffer.from(secret).toString("base64url");
    const cp = proc.spawnSync(
      "secret-tool",
      ["store", `--label="${this.#label ?? ""}"`, ...this.#attributes.flat()],
      { encoding: "utf8", input },
    );
    if (cp.status !== 0) {
      throw new Error(
        `Couldn't write secret "${this.#label}" with attributes: \n${this.#attributes.map(([key, value]) => `  ${key}="${value}"`)}`,
      );
    }
    return;
  }
}

export class KeychainSecret {
  #service;
  #account;
  constructor(service, account) {
    this.#service = service;
    this.#account = account;
  }
  async read() {
    const cp = proc.spawnSync(
      "security",
      ["find-generic-password", "-s", this.#service, "-a", this.#account, "-w"],
      { encoding: "utf8" },
    );
    if (cp.status !== 0) {
      throw Object.assign(
        new Error(
          `Couldn't read secret for service "${this.#service}", account "${this.#account}"`,
        ),
        { code: "ENOENT" },
      );
    }
    return new Uint8Array(Buffer.from(cp.stdout.trim(), "base64url"));
  }
  async write(secret) {
    const input = Buffer.from(secret).toString("base64url");
    const cp = proc.spawnSync(
      "security",
      [
        "add-generic-password",
        "-U",
        "-s",
        this.#service,
        "-a",
        this.#account,
        "-w",
        input,
      ],
      { encoding: "utf8" },
    );
    if (cp.status !== 0) {
      throw new Error(
        `Couldn't write secret for service "${this.#service}", account "${this.#account}"`,
      );
    }
    return;
  }
}

export class WindowsSecureStringSecret {
  #path;
  constructor(path) {
    this.#path = path;
  }
  async read() {
    const psCommand = [
      `Import-CliXml -Path ${JSON.stringify(this.#path)}`,
      "ConvertFrom-SecureString -AsPlainText",
    ].join(" | ");

    const cp = proc.spawnSync(
      "powershell",
      ["-NoProfile", `-Command`, psCommand],
      {
        encoding: "utf8",
      },
    );
    if (cp.status !== 0) {
      throw Object.assign(new Error(`Couldn't read secret ${this.#path}`), {
        code: "ENOENT",
      });
    }
    return new Uint8Array(Buffer.from(cp.stdout, "base64url"));
  }
  async write(secret) {
    const input = Buffer.from(secret).toString("base64url");
    const psCommand = [
      JSON.stringify(input),
      "ConvertTo-SecureString -AsPlainText -Force",
      `Export-CliXml -Path ${JSON.stringify(this.#path)}`,
    ].join(" | ");
    const cp = proc.spawnSync(
      "powershell",
      ["-NoProfile", `-Command`, psCommand],
      {
        encoding: "utf8",
      },
    );
    if (cp.status !== 0) {
      throw new Error(`Couldn't write secret "${this.#path}"`);
    }

    return;
  }
}

export const encrypt = async (key, bytes) => {
  const iv = getRandomValues(new Uint8Array(12));
  return [
    iv,
    new Uint8Array(
      await subtle.encrypt(
        { name: "AES-GCM", iv },
        await subtle.importKey("raw", key, "AES-GCM", true, [
          "encrypt",
          "decrypt",
        ]),
        bytes,
      ),
    ),
  ];
};

export const decrypt = async (key, [iv, encrypted] = []) =>
  !iv
    ? undefined
    : await subtle.decrypt(
        { name: "AES-GCM", iv },
        await subtle.importKey("raw", key, "AES-GCM", true, [
          "encrypt",
          "decrypt",
        ]),
        encrypted,
      );

export const APP_SECRET = "So, I really hate TOTP apps, turns out.";
export const getUserHash = async (user, uid) =>
  crypto.subtle.digest("SHA-256", encode(`${user}:${uid}:${APP_SECRET}`));
export const getPasswordHash = async (password) =>
  crypto.subtle.digest("SHA-256", encode(password));
export const toBase64 = (u8) => Buffer.from(u8).toString("base64url");

export const fromBase64 = (str) =>
  new Uint8Array(Buffer.from(str, "base64url"));

export class BinarySecret {
  #file;
  #user;
  #uid;
  constructor(file, user, uid) {
    this.#file = file;
    this.#user = user;
    this.#uid = uid;
  }

  async read() {
    const mode = (await stat(this.#file)).mode & 0o777;
    const [iv, encrypted] = (await readFile(this.#file, "utf8"))
      .split("/")
      .map(fromBase64);
    return await decrypt(await getUserHash(this.#user, this.#uid), [
      iv,
      encrypted,
    ]);
  }

  async write(secret) {
    if (typeof secret === "string") {
      secret = new TextEncoder().encode(secret);
    }
    const payload = (
      await encrypt(await getUserHash(this.#user, this.#uid), secret)
    )
      .map(toBase64)
      .join("/");
    await writeFile(this.#file, payload, "utf8");
    await chmod(this.#file, 0o600);
  }
}

export const slugify = (str) =>
  str
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "_")
    .replace(/^_+|_+$/g, "");

export const urlFromGoogleAuthenticatorAccount = ({
  secret,
  name,
  issuer,
  algorithm,
  digits,
  period,
}) => {
  const label = issuer ? `${issuer}:${name}` : name;
  const url = new URL(`otpauth://totp/${encodeURIComponent(label)}`);
  url.searchParams.set("secret", secret);
  if (issuer) url.searchParams.set("issuer", issuer);
  if (algorithm && algorithm.toUpperCase() !== "SHA1") {
    url.searchParams.set("algorithm", algorithm);
  }
  if (digits && Number(digits) !== 6) {
    url.searchParams.set("digits", String(digits));
  }
  if (period && Number(period) !== 30) {
    url.searchParams.set("period", String(period));
  }
  return url;
};

export const isGoogleAuthenticatorExport = (data) =>
  !!data &&
  typeof data === "object" &&
  Array.isArray(data.accounts) &&
  data.accounts.every((a) => a && typeof a.secret === "string");

export const isOtpUrlListExport = (data) =>
  Array.isArray(data) && data.every((entry) => isOtpUrl(entry));

export const nameForImportedUrl = (usedNames, url) => {
  const { issuer, account } = parseOtpUrl(url);
  const issuerSlug = slugify(issuer ?? account);
  let name = issuerSlug;
  if (usedNames.has(name)) {
    name = `${issuerSlug}_${slugify(account)}`;
  }
  usedNames.add(name);
  return name;
};

export class SecretManager {
  #secretService;
  #file;
  #migration;
  #open() {
    const store = new DatabaseSync(this.#file);
    store.exec(
      `CREATE TABLE IF NOT EXISTS store (key TEXT PRIMARY KEY, iv BLOB, encrypted BLOB)`,
    );
    const getValueByKey = store.prepare(
      "SELECT iv, encrypted FROM store WHERE key = ?",
    );
    const setValueByKey = store.prepare(
      "INSERT INTO store (key, iv, encrypted) VALUES(?, ?, ?) ON CONFLICT (key) DO UPDATE SET iv = excluded.iv, encrypted = excluded.encrypted",
    );
    const listKeys = store.prepare("SELECT key FROM store ORDER BY key ASC");
    const deleteByKey = store.prepare("DELETE FROM store WHERE key = ?");
    const renameKey = store.prepare("UPDATE store SET key = ? WHERE key = ?");
    return {
      get: (key) => {
        const { iv, encrypted } = getValueByKey.get(key) ?? {};
        return iv ? [iv, encrypted] : undefined;
      },
      set: (key, [iv, encrypted]) => {
        setValueByKey.run(key, iv, encrypted);
      },
      list: () => listKeys.all(),
      delete: (key) => deleteByKey.run(key).changes > 0,
      rename: (from, to) => renameKey.run(to, from).changes > 0,
      close: () => store.close(),
    };
  }
  constructor(
    appName,
    {
      XDG_SESSION_TYPE,
      DBUS_SESSION_BUS_ADDRESS,
      USER,
      UID,
      HOME,
      USERPROFILE,
    } = process.env,
    { verbose, home: flagHome } = defaultFlags,
  ) {
    const user =
      USER ??
      (HOME && basename(HOME)) ??
      (USERPROFILE && basename(USERPROFILE)) ??
      "root";
    const home =
      HOME ?? USERPROFILE ?? (user === "root" ? "/root" : `/home/${user}`);
    const local = flagHome ?? join(home, ".local");
    mkdirSync(local, { recursive: true });
    const keyFile = join(local, `${appName}.key`);
    const storeFile = join(local, `${appName}.store`);
    if (process.platform === "win32") {
      if (verbose) {
        process.stderr.write(`Using WindowsSecureString in ${keyFile}\n`);
      }
      this.#secretService = new WindowsSecureStringSecret(keyFile);
    } else if (process.platform === "darwin") {
      if (verbose) {
        process.stderr.write(`Using Keychain for ${appName}/${user}\n`);
      }
      this.#secretService = new KeychainSecret(appName, user);
    } else if (
      XDG_SESSION_TYPE !== "tty" &&
      DBUS_SESSION_BUS_ADDRESS &&
      hasCommand("secret-tool")
    ) {
      if (verbose) {
        process.stderr.write(`Using SecretService\n`);
      }
      this.#secretService = new SecretServiceSecret({ domain: appName });
    } else {
      if (verbose) {
        process.stderr.write(`Using BinarySecret at ${keyFile}\n`);
      }
      this.#secretService = new BinarySecret(keyFile, user, UID ?? 0);
    }
    if (!(this.#secretService instanceof BinarySecret) && existsSync(keyFile)) {
      if (verbose) {
        process.stderr.write(
          `Migrating BinarySecret at ${keyFile} to the new provider\n`,
        );
      }
      this.#migration = {
        from: new BinarySecret(keyFile, user, UID ?? 0),
        keyFile,
      };
    }
    this.#file = storeFile;
  }
  get secretService() {
    return this.#secretService;
  }
  async getSecret() {
    if (this.#migration) {
      const { from, keyFile } = this.#migration;
      this.#migration = undefined;
      const secret = await from.read();
      await this.#secretService.write(secret);
      renameSync(keyFile, `${keyFile}.migrated`);
      return secret;
    }
    try {
      return await this.#secretService.read();
    } catch (e) {
      if (e.code === "ENOENT") {
        const secret = getRandomValues(new Uint8Array(32));
        await this.#secretService.write(secret);
        return secret;
      }
      throw e;
    }
  }
  async get(name) {
    const secret = await this.getSecret();
    const db = this.#open();
    try {
      return decode(await decrypt(secret, db.get(name)));
    } finally {
      db.close();
    }
  }
  async set(name, value) {
    const secret = await this.getSecret();
    const db = this.#open();
    const [iv, encrypted] = await encrypt(secret, encode(value));
    try {
      return db.set(name, [iv, encrypted]);
    } finally {
      db.close();
    }
  }

  async list() {
    const db = this.#open();
    try {
      return db.list().map(({ key }) => key);
    } finally {
      db.close();
    }
  }

  async delete(name) {
    const db = this.#open();
    try {
      return db.delete(name);
    } finally {
      db.close();
    }
  }

  async rename(from, to) {
    const db = this.#open();
    try {
      if (db.get(to)) {
        throw new Error(`"${to}" already exists`);
      }
      return db.rename(from, to);
    } finally {
      db.close();
    }
  }

  async export(password, file) {
    const names = await this.list();
    if (!password) {
      const urls = [];
      for (const name of names) {
        urls.push(await this.get(name));
      }
      await writeFile(file, urls.join("\n") + "\n", "utf8");
      return;
    }
    const entries = {};
    for (const name of names) {
      entries[name] = await this.get(name);
    }
    const json = gzipSync(encode(JSON.stringify(entries)), { level: 9 });
    const [iv, encrypted] = await encrypt(
      await getPasswordHash(password),
      json,
    );
    await writeFile(
      file,
      Buffer.concat([Buffer.from(iv), Buffer.from(encrypted)]),
    );
  }

  async import(getPassword, file) {
    const bytes = await readFile(file);
    let text;
    try {
      text = new TextDecoder("utf-8", { fatal: true }).decode(bytes);
    } catch {
      text = undefined;
    }
    let data;
    if (text !== undefined) {
      try {
        data = JSON.parse(text);
      } catch {
        const lines = text
          .split("\n")
          .map((line) => line.trim())
          .filter((line) => line.length > 0 && !line.startsWith("#"));
        if (lines.length === 0 || !lines.every((line) => isOtpUrl(line))) {
          throw new Error(`"${file}" is not a recognized OTP export format`);
        }
        data = lines;
      }
    } else {
      const password =
        typeof getPassword === "function" ? await getPassword() : getPassword;
      const iv = bytes.subarray(0, 12);
      const encrypted = bytes.subarray(12);
      const json = await decrypt(await getPasswordHash(password), [
        iv,
        encrypted,
      ]);
      data = JSON.parse(decode(gunzipSync(json)));
    }
    const existingNames = new Set(await this.list());
    const report = { added: [], updated: [] };
    const record = (name) => {
      report[existingNames.has(name) ? "updated" : "added"].push(name);
      existingNames.add(name);
    };
    if (isGoogleAuthenticatorExport(data)) {
      const usedNames = new Set(existingNames);
      for (const account of data.accounts) {
        const url = urlFromGoogleAuthenticatorAccount(account);
        const name = nameForImportedUrl(usedNames, url);
        await this.set(name, url.toString());
        record(name);
      }
      return report;
    }
    if (isOtpUrlListExport(data)) {
      const usedNames = new Set(existingNames);
      for (const url of data) {
        const name = nameForImportedUrl(usedNames, url);
        await this.set(name, new URL(url).toString());
        record(name);
      }
      return report;
    }
    for (const [name, value] of Object.entries(data)) {
      await this.set(name, value);
      record(name);
    }
    return report;
  }
}

export const fromBase32 = Object.assign(
  (str) =>
    str &&
    new Uint8Array(
      [...str.toUpperCase().padEnd(Math.ceil(str.length / 8) * 8, "A")]
        .map((a) => fromBase32[a])
        .join("")
        .match(/.{1,8}/g)
        .map((a) => parseInt(a, 2)),
    ),
  {
    alphabet: "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567",
    rx: /^[a-zA-Z2-7]+$/i,
    is: (s) =>
      typeof s === "string" && fromBase32.rx.test(s) && s.length % 8 === 0,
    isSecret: (s) => typeof s === "string" && fromBase32.rx.test(s),
    random: (n) =>
      [...getRandomValues(new Uint8Array(16 * n))]
        .map((k) => fromBase32.alphabet[k & 31])
        .join(""),
  },
);
Object.assign(
  fromBase32,
  Object.fromEntries(
    [...fromBase32.alphabet].map((key, index) => [
      key,
      index.toString(2).padStart(5, 0),
    ]),
  ),
);

export function padCounter(counter) {
  const array = new Uint8Array(8).fill(0);
  counter = counter.toString(16).padStart(16, "0");
  let byte = 0;
  while (counter.length) {
    array[byte++] = parseInt(counter.slice(0, 2), 16);
    counter = counter.slice(2);
  }
  return array;
}

export function truncate(hmac, digits) {
  const offset = hmac[hmac.length - 1] & 0x0f;
  const value =
    ((hmac[offset + 0] & 0x7f) << 24) |
    ((hmac[offset + 1] & 0xff) << 16) |
    ((hmac[offset + 2] & 0xff) << 8) |
    (hmac[offset + 3] & 0xff);
  return value % 10 ** digits;
}
export const isOtpUrl = (url) => {
  try {
    url = url instanceof URL ? url : new URL(url);
  } catch {
    return false;
  }
  if (url.protocol !== "otpauth:") {
    return false;
  }
  const type = url.hostname.toLowerCase();
  if (type !== "totp" && type !== "hotp") {
    return false;
  }
  if (!fromBase32.isSecret(url.searchParams.get("secret") ?? "")) {
    return false;
  }
  if (url.searchParams.has("digits")) {
    const digits = url.searchParams.get("digits");
    if (!/^\d+$/.test(digits) || Number(digits) < 1) {
      return false;
    }
  }
  if (url.searchParams.has("algorithm")) {
    if (!/^(sha)-?(1|256|384|512)$/i.test(url.searchParams.get("algorithm"))) {
      return false;
    }
  }
  if (type === "totp") {
    if (url.searchParams.has("counter")) {
      return false;
    }
    if (url.searchParams.has("period")) {
      const period = url.searchParams.get("period");
      if (!/^\d+$/.test(period) || Number(period) < 1) {
        return false;
      }
    }
  }
  if (type === "hotp") {
    if (url.searchParams.has("period")) {
      return false;
    }
    if (url.searchParams.has("counter")) {
      const counter = url.searchParams.get("counter");
      if (!/^\d+$/.test(counter)) {
        return false;
      }
    }
  }
  return true;
};

export const parseOtpUrl = (url) => {
  url = url instanceof URL ? url : new URL(url);
  const type = url.hostname.toLowerCase() === "totp" ? "totp" : "hotp";
  const label = decodeURIComponent(url.pathname.replace(/^\//, ""));
  const [labelIssuer, labelAccount] = label.includes(":")
    ? label.split(/:(.*)/s).slice(0, 2)
    : [undefined, label];
  const issuer = url.searchParams.get("issuer") ?? labelIssuer;
  const account = labelAccount || label;
  const algorithm = (url.searchParams.get("algorithm") ?? "SHA1").toUpperCase();
  const digits = url.searchParams.get("digits") ?? "6";
  return { type, issuer, account, algorithm, digits };
};

export const otp = async (url) => {
  url = url instanceof URL ? url : new URL(url);
  const type = url.hostname.toLowerCase() === "totp" ? "totp" : "hotp";
  const period =
    type === "totp"
      ? parseInt(url.searchParams.get("period") ?? 30)
      : undefined;
  const counter = padCounter(
    type === "totp"
      ? Math.floor(Date.now() / 1000 / period)
      : parseInt(url.searchParams.get("counter") ?? 0),
  );
  const secret = fromBase32(url.searchParams.get("secret"));
  const digits = parseInt(url.searchParams.get("digits") ?? 6);
  const algorithm = [
    ...((url.searchParams.get("algorithm") ?? "sha1").match(
      /^(sha)-?(1|256|384|512)$/i,
    ) ?? []),
  ]
    .slice(1)
    .join("-")
    .toUpperCase();
  const hmacKey = await crypto.subtle.importKey(
    "raw",
    secret,
    { name: "HMAC", hash: { name: algorithm } },
    false,
    ["sign"],
  );
  const hmac = await crypto.subtle.sign("HMAC", hmacKey, counter);
  return String(truncate(new Uint8Array(hmac), digits)).padStart(digits, "0");
};

export const markdownTable = (rows) => {
  const widths = rows[0].map((_, col) =>
    Math.max(...rows.map((row) => String(row[col]).length)),
  );
  const renderRow = (row) =>
    `| ${row.map((cell, col) => String(cell).padEnd(widths[col])).join(" | ")} |`;
  const separator = `| ${widths.map((w) => "-".repeat(w)).join(" | ")} |`;
  return [renderRow(rows[0]), separator, ...rows.slice(1).map(renderRow)].join(
    "\n",
  );
};


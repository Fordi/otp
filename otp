const INDENT = "  ";
function indent(text, skipFirst = false) {
  return `${skipFirst ? "" : INDENT}${text.split("\n").join(`\n${INDENT}`)}`;
}
let footnote = 1;
const processCommandSet = (set) =>
  Object.entries(set).reduce(
    (obj, [name, [aliases, execute, description, extra]]) => {
      const info = {
        execute,
        arity: Math.max(0, execute.length - 1),
        name,
        aliases: [name, ...aliases],
        description: `${description}${extra ? `[^${footnote}]` : ""}`,
        ...(extra ? { extra: `[^${footnote}]: ${indent(extra, true)}` } : {}),
      };
      obj[name] = info;
      for (const shorthand of aliases) {
        if (shorthand === "") {
          obj[shorthand] = { ...info, blank: true };
        } else {
          obj[shorthand] = info;
        }
      }
      return obj;
    },
    { "": [] },
  );

const clipCommands = {
  win32: ["clip", []],
  darwin: ["pbcopy", []],
};

export const clip = (text) => {
  const [cmd, args] =
    clipCommands[process.platform] ??
    (process.env.WAYLAND_DISPLAY
      ? ["wl-copy", []]
      : ["xclip", ["-selection", "clipboard"]]);
  return proc.spawnSync(cmd, args, {
    input: text,
    encoding: "utf-8",
    stdio: ["pipe", "ignore", "ignore"],
  });
};

export const flagsDefault = () =>
  process.stdout.isTTY ? { clipboard: true } : { stdout: true };

const SOURCE =
  "https://raw.githubusercontent.com/Fordi/otp/refs/heads/main/otp";

export async function update({ verbose } = {}) {
  if (verbose) {
    process.stderr.write(`Updating from ${SOURCE}`);
  }
  await writeFile(process.argv[1], await fetch(SOURCE).then((r) => r.body));
  throw new UpdateCompleteNonError();
}

const flipFlag =
  (name) =>
  ({ flags, ...rest }) => ({
    ...rest,
    flags: { ...flags, [name]: !flags[name] },
  });
const takeFlag =
  (name) =>
  ({ flags, ...rest }, arg) => ({ ...rest, flags: { ...flags, [name]: arg } });
const incrementFlag =
  (name) =>
  ({ flags, ...rest }) => ({
    ...rest,
    flags: { ...flags, [name]: (flags[name] ?? 0) + 1 },
  });
const _ = undefined;


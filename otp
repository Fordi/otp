const handleCli = ({
  arg,
  prefix = "",
  type,
  name,
  of,
  allowArg = true,
  allowShort = true,
  args,
}) => {
  let desc = of[name] ?? of[""];
  if (!desc || (!allowShort && desc.name !== name)) {
    throw new Error(`Unknown ${type}: ${prefix}${name}`);
  }

  if (desc.arity !== 0 && !allowArg) {
    throw new Error(`${type} ${prefix}${desc.name} must be last in group`);
  }
  const consumedArgs = args.splice(0, desc.arity);
  if (desc.blank) {
    consumedArgs.unshift(arg);
  }
  if (consumedArgs.length < desc.arity) {
    throw new Error(
      `${type} ${prefix}${desc.name} requires ${desc.arity} arguments, got ${consumedArgs.length}`,
    );
  }
  return [desc, consumedArgs];
};

export async function parseArgs(args) {
  let context = { commands: [], flags: { ...flagsDefault() } };
  const copy = [...args];
  while (copy.length) {
    const arg = copy.shift();
    const d = arg.startsWith("-") && arg.length >= 2;
    const dd = arg.startsWith("--");
    if (d && !dd) {
      for (let i = 1; i < arg.length; i++) {
        const [desc, flagArgs] = handleCli({
          arg,
          args: copy,
          prefix: "-",
          type: "flag",
          name: arg[i],
          of: FLAGS,
          allowArg: i === arg.length - 1,
        });
        context = await desc.execute(context, ...flagArgs);
      }
      continue;
    }
    if (dd && arg.length > 3) {
      const [desc, flagArgs] = handleCli({
        arg,
        args: copy,
        prefix: "--",
        type: "flag",
        name: arg.slice(2).toLowerCase(),
        of: FLAGS,
        allowShort: false,
      });
      context = await desc.execute(context, ...flagArgs);
      continue;
    }
    const [desc, cmdArgs] = handleCli({
      arg,
      args: copy,
      type: "command",
      name: arg.toLowerCase(),
      of: COMMANDS,
      allowUnknown: true,
    });
    context.commands.push({
      flags: { ...context.flags },
      name: desc.name,
      args: cmdArgs,
    });
    context.flags = flagsDefault();
  }
  if (context.commands.length === 0) {
    return [{ name: COMMANDS.default.name, args: [], flags: context.flags }];
  }
  return context.commands;
}

export const logAndClipCode = async (url, flags) => {
  const code = await otp(url instanceof URL ? url.toString() : url);
  if (flags.stdout) console.log(code);
  if (flags.clipboard) clip(code);
};

export const ANONYMOUS_NO_ACCOUNT = "ANONYMOUS_NO_ACCOUNT";

export const urlFromSecret = (secret) => {
  const url = new URL(`otpauth://totp/${ANONYMOUS_NO_ACCOUNT}`);
  url.searchParams.set("secret", secret);
  return url;
};
let store;

export async function main(args, env) {
  try {
    for (const { name, args: cmdArgs, flags } of await parseArgs(args)) {
      const store = new SecretManager("org.fordi.otp", env, flags);
      await COMMANDS[name].execute({ store, flags, env }, ...cmdArgs);
    }
  } catch (e) {
    const ok = e.ok ?? false;
    if (e.silent) {
      process.exit(ok ? 0 : 1);
      return;
    }
    await usage(ok ? 0 : 1, e.message || undefined);
  }
}

